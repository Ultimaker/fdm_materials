{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "type": "command",
        "bash": "python3 ./.agents/hooks/block-absolute-paths.py",
        "timeoutSec": 15
      },
      {
        "type": "command",
        "bash": "python3 ./.agents/hooks/block-secrets.py",
        "timeoutSec": 15
      },
      {
        "type": "command",
        "bash": "python3 ./.agents/hooks/git-branch-guard.py",
        "timeoutSec": 15
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "bash": "bash ./.agents/hooks/post-edit-linter.sh",
        "timeoutSec": 30
      }
    ]
  }
}
